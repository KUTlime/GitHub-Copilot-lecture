<?xml version="1.0" encoding="utf-8"?>
<!--
  Only nuget.org is allowed, and every package must be mapped to it.
  Package source mapping prevents dependency confusion and makes it impossible
  to restore a (hallucinated) package from an unexpected feed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
